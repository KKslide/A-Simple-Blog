{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.3",
  "scripts": {
    "dev": "tsx watch src/bin/www.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/bin/www.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "format": "prettier --write src/",
    "hash-password": "tsx src/scripts/hash-password.ts"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.18.2",
    "express-static-gzip": "^3.0.0",
    "formidable": "^3.5.4",
    "http-errors": "~2.0.1",
    "morgan": "~1.9.1",
    "mysql2": "^3.12.0",
    "qiniu": "^7.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@eslint/json": "^0.13.1",
    "@eslint/markdown": "^7.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/debug": "^4.1.13",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/formidable": "^3.5.1",
    "@types/http-errors": "^2.0.5",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.20.4",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1"
  }
}
